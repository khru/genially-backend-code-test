{
  "name": "mongo-migrations",
  "version": "1.0.0",
  "description": "MongoDB schema migrations for genially",
  "main": "migrate-mongo-config.js",
  "scripts": {
    "create": "migrate-mongo create",
    "migrate": "migrate-mongo up",
    "down": "migrate-mongo down",
    "down:all": "migrate-mongo down -b -- --env-file=.env.local",
    "status": "migrate-mongo status",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "mongodb",
    "migrations",
    "schema"
  ],
  "author": "Emmanuel Valverde Ramos",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "lint-staged": "^15.0.0",
    "migrate-mongo": "^12.1.3",
    "mongodb": "^6.20.0",
    "prettier": "^3.0.0"
  }
}
