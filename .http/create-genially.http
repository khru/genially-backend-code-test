## Create Genially - Valid with description
POST {{baseUrl}}/genially
Content-Type: application/json

{
  "id": "{{$random.idNumber.valid}}",
  "name": "{{$random.alphabetic(15)}}",
  "description": "{{$random.alphabetic(100)}}"
}
> {%
  client.test("201 + JSON", () => {
    client.assert(response.status === 201, `Expected 201 got ${response.status}`);
    client.assert(response.contentType.mimeType === "application/json");
  });
%}

### Name exactly 3 characters (boundary - should pass)
POST {{baseUrl}}/genially
Content-Type: application/json

{
  "id": "{{$random.idNumber.valid}}",
  "name": "{{$random.alphabetic(3)}}",
  "description": "{{$random.alphabetic(100)}}"
}
> {%
  client.test("201 on 3-char name", () => {
    client.assert(response.status === 201, `Expected 201 got ${response.status}`);
  });
%}

### Description exactly 125 (boundary - should pass)
POST {{baseUrl}}/genially
Content-Type: application/json

{
  "id": "{{$random.idNumber.valid}}",
  "name": "{{$random.alphabetic(15)}}",
  "description": "{{$random.alphabetic(125)}}"
}
> {%
  client.test("201 on 125-char description", () => {
    client.assert(response.status === 201, `Expected 201 got ${response.status}`);
  });
%}

### Multiple validation errors (should fail)
POST {{baseUrl}}/genially
Content-Type: application/json

{
  "id": "{{$random.idNumber.valid}}",
  "name": "{{$random.alphabetic(2)}}",
  "description": "{{$random.alphabetic(126)}}"
}
> {%
  client.test("400 on invalid name + description", () => {
    client.assert(response.status === 400, `Expected 400 got ${response.status}`);
  });
%}
