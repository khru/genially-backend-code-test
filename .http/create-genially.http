### Create Genially - Empty description (should pass)
POST {{baseUrl}}/genially
Content-Type: application/json

{
  "id": "{{$random.idNumber.valid}}",
  "name": "{{$randomAlphabetic(15)}}",
  "description": ""
}
> {%
  client.test("Create Genially - Empty description (should pass) should return status 201", function () {
    client.assert(response.status === 201, "Expected status 201");
    client.assert(response.body.description === "", "Description should be empty string");
  });
%}

### Create Genially - Multiple validation errors (name too short + description too long)
POST {{baseUrl}}/genially
Content-Type: application/json

{
  "id": "{{$random.idNumber.valid}}",
  "name": "{{$randomAlphabetic(2)}}",
  "description": "{{$randomAlphabetic(126)}}"
}
> {%
  client.test("Create Genially - Multiple validation errors (name too short + description too long) should return status 400", function () {
    client.assert(response.status === 400, "Expected status 400");
  });
%}
